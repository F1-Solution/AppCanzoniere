<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppCanzoniere.MAUI.ViewModels"
             xmlns:dto="clr-namespace:AppCanzoniere.Application.DTOs.Backend;assembly=AppCanzoniere.Application"
             x:Class="AppCanzoniere.MAUI.Pages.PublicSongsPage"
             Title="Public Songs"
             x:DataType="vm:PublicSongsViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Padding="10">
        
        <!-- Search Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <SearchBar Grid.Column="0"
                      Text="{Binding SearchQuery}"
                      Placeholder="Search songs..."
                      SearchCommand="{Binding SearchSongsCommand}"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
            
            <Button Grid.Column="1"
                    Text="🔄"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    Margin="5,0,0,0" />
        </Grid>

        <!-- Songs List -->
        <CollectionView Grid.Row="1"
                       ItemsSource="{Binding Songs}"
                       SelectionMode="Single"
                       SelectedItem="{Binding SelectedSong}"
                       SelectionChangedCommand="{Binding SelectSongCommand}"
                       SelectionChangedCommandParameter="{Binding SelectedSong}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:PublicSongDto">
                    <Frame Padding="10" Margin="5" BorderColor="{StaticResource Primary}" CornerRadius="5">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            
                            <!-- Title -->
                            <Label Grid.Column="0" Grid.Row="0"
                                  Text="{Binding Title}"
                                  FontSize="18"
                                  FontAttributes="Bold" />
                            
                            <!-- Artist -->
                            <Label Grid.Column="0" Grid.Row="1"
                                  Text="{Binding Artist}"
                                  FontSize="14"
                                  TextColor="{StaticResource Gray600}" />
                            
                            <!-- Key and Date -->
                            <Label Grid.Column="0" Grid.Row="2"
                                  Text="{Binding OriginalKey, StringFormat='Key: {0}'}"
                                  FontSize="12"
                                  TextColor="{StaticResource Gray500}" />
                            
                            <Label Grid.Column="1" Grid.RowSpan="3"
                                  Text="📖"
                                  FontSize="24"
                                  VerticalOptions="Center" />
                            
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            
            <CollectionView.EmptyView>
                <StackLayout Padding="20" VerticalOptions="Center">
                    <Label Text="No public songs found"
                          HorizontalOptions="Center"
                          TextColor="{StaticResource Gray600}"
                          FontSize="16" />
                    <Label Text="Try searching or refreshing"
                          HorizontalOptions="Center"
                          TextColor="{StaticResource Gray500}"
                          FontSize="14"
                          Margin="0,5,0,0" />
                </StackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Bottom Bar -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            
            <!-- Status Message -->
            <Label Grid.Column="0"
                  Text="{Binding StatusMessage}"
                  VerticalOptions="Center"
                  IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}" />
            
            <!-- Login Button -->
            <Button Grid.Column="1"
                    Text="Login"
                    Command="{Binding NavigateToLoginCommand}"
                    IsVisible="{Binding IsAuthenticated, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="{StaticResource Primary}" />
            
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3"
             IsVisible="{Binding IsBusy}"
             BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                              Color="{StaticResource Primary}"
                              VerticalOptions="Center"
                              HorizontalOptions="Center" />
        </Grid>
        
    </Grid>

</ContentPage>
