<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppCanzoniere.MAUI.ViewModels"
             xmlns:entities="clr-namespace:AppCanzoniere.Domain.Entities;assembly=AppCanzoniere.Domain"
             x:Class="AppCanzoniere.MAUI.Pages.SongMetadataPage"
             x:DataType="vm:SongMetadataViewModel"
             Title="Song Metadata">

    <ScrollView>
        <VerticalStackLayout Padding="15"
                             Spacing="20">
            
            <!-- Tags Section -->
            <Frame BorderColor="{StaticResource Gray200}"
                   CornerRadius="10"
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🏷️ Tags"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <!-- Selected Tags -->
                    <Label Text="Selected Tags:"
                           FontSize="14"
                           FontAttributes="Bold"
                           Margin="0,10,0,5" />
                    
                    <FlexLayout BindableLayout.ItemsSource="{Binding SelectedTags}"
                                Wrap="Wrap"
                                JustifyContent="Start"
                                AlignItems="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="entities:Tag">
                                <Frame Padding="10,5"
                                       Margin="5"
                                       BackgroundColor="{StaticResource Primary}"
                                       CornerRadius="15"
                                       HasShadow="False">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SongMetadataViewModel}}, Path=RemoveTagCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{Binding Name}"
                                               TextColor="White"
                                               FontSize="12" />
                                        <Label Text="✕"
                                               TextColor="White"
                                               FontSize="10" />
                                    </HorizontalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Label Text="(Tap to remove)"
                           FontSize="10"
                           TextColor="{StaticResource Gray500}"
                           IsVisible="{Binding SelectedTags.Count}" />

                    <!-- Available Tags -->
                    <Label Text="Available Tags:"
                           FontSize="14"
                           FontAttributes="Bold"
                           Margin="0,10,0,5" />
                    
                    <FlexLayout BindableLayout.ItemsSource="{Binding AvailableTags}"
                                Wrap="Wrap"
                                JustifyContent="Start"
                                AlignItems="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="entities:Tag">
                                <Frame Padding="10,5"
                                       Margin="5"
                                       BackgroundColor="{StaticResource Gray100}"
                                       BorderColor="{StaticResource Primary}"
                                       CornerRadius="15"
                                       HasShadow="False">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SongMetadataViewModel}}, Path=AddTagCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{Binding Name}"
                                               TextColor="{StaticResource Primary}"
                                               FontSize="12" />
                                        <Label Text="+"
                                               TextColor="{StaticResource Primary}"
                                               FontSize="10" />
                                    </HorizontalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- Create New Tag -->
                    <Label Text="Create New Tag:"
                           FontSize="14"
                           FontAttributes="Bold"
                           Margin="0,10,0,5" />
                    
                    <HorizontalStackLayout Spacing="10">
                        <Entry Text="{Binding NewTagName}"
                               Placeholder="Tag name..."
                               HorizontalOptions="FillAndExpand" />
                        <Button Text="Create"
                                Command="{Binding CreateAndAddTagCommand}"
                                BackgroundColor="{StaticResource Primary}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Liturgical Moments Section -->
            <Frame BorderColor="{StaticResource Gray200}"
                   CornerRadius="10"
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="⛪ Liturgical Moments"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <!-- Selected Moments -->
                    <Label Text="Selected Moments:"
                           FontSize="14"
                           FontAttributes="Bold"
                           Margin="0,10,0,5" />
                    
                    <CollectionView ItemsSource="{Binding SelectedLiturgicalMoments}">
                        <CollectionView.EmptyView>
                            <Label Text="No liturgical moments selected"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}"
                                   Margin="10" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="entities:LiturgicalMoment">
                                <Frame Padding="10"
                                       Margin="0,5"
                                       BackgroundColor="{StaticResource Primary}"
                                       CornerRadius="8">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SongMetadataViewModel}}, Path=RemoveLiturgicalMomentCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding Name}"
                                               TextColor="White"
                                               FontSize="14"
                                               HorizontalOptions="StartAndExpand" />
                                        <Label Text="✕"
                                               TextColor="White" />
                                    </HorizontalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Available Moments -->
                    <Label Text="Available Moments:"
                           FontSize="14"
                           FontAttributes="Bold"
                           Margin="0,10,0,5" />
                    
                    <CollectionView ItemsSource="{Binding AvailableLiturgicalMoments}">
                        <CollectionView.EmptyView>
                            <Label Text="All moments are already selected"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}"
                                   Margin="10" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="entities:LiturgicalMoment">
                                <Frame Padding="10"
                                       Margin="0,5"
                                       BackgroundColor="{StaticResource Gray100}"
                                       BorderColor="{StaticResource Primary}"
                                       CornerRadius="8">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SongMetadataViewModel}}, Path=AddLiturgicalMomentCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding Name}"
                                               TextColor="{StaticResource Primary}"
                                               FontSize="14"
                                               HorizontalOptions="StartAndExpand" />
                                        <Label Text="+"
                                               TextColor="{StaticResource Primary}" />
                                    </HorizontalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Bible References Section -->
            <Frame BorderColor="{StaticResource Gray200}"
                   CornerRadius="10"
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📖 Bible References"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <!-- Current References -->
                    <CollectionView ItemsSource="{Binding BibleReferences}">
                        <CollectionView.EmptyView>
                            <Label Text="No bible references added"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}"
                                   Margin="10" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="entities:BibleReference">
                                <Frame Padding="10"
                                       Margin="0,5"
                                       BackgroundColor="{StaticResource Gray100}"
                                       BorderColor="{StaticResource Gray300}"
                                       CornerRadius="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding DisplayText}"
                                               FontSize="14" />
                                        <Button Grid.Column="1"
                                                Text="✕"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SongMetadataViewModel}}, Path=RemoveBibleReferenceCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource Tertiary}"
                                                FontSize="16"
                                                Padding="5" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Add New Reference -->
                    <Label Text="Add New Reference:"
                           FontSize="14"
                           FontAttributes="Bold"
                           Margin="0,10,0,5" />
                    
                    <Entry Text="{Binding NewBibleBook}"
                           Placeholder="Book (e.g., Genesis, John, Psalms)" />
                    
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">
                        <Entry Grid.Column="0"
                               Text="{Binding NewBibleChapter}"
                               Placeholder="Chapter" />
                        <Entry Grid.Column="1"
                               Text="{Binding NewBibleVerse}"
                               Placeholder="Verse" />
                    </Grid>
                    
                    <Button Text="Add Reference"
                            Command="{Binding AddBibleReferenceCommand}"
                            BackgroundColor="{StaticResource Primary}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Primary}"
                               Margin="0,20" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
