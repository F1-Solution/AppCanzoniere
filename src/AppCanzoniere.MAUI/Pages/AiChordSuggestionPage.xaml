<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppCanzoniere.MAUI.ViewModels"
             x:Class="AppCanzoniere.MAUI.Pages.AiChordSuggestionPage"
             x:DataType="vm:AiChordSuggestionViewModel"
             Title="AI Chord Suggestions">

    <ScrollView>
        <VerticalStackLayout Padding="15"
                             Spacing="20">

            <!-- Header Info -->
            <Frame BackgroundColor="{StaticResource Primary}"
                   CornerRadius="10"
                   Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="🤖 AI-Powered Chord Suggestions"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Get chord progressions generated by AI for your songs"
                           FontSize="14"
                           TextColor="White"
                           Opacity="0.9" />
                </VerticalStackLayout>
            </Frame>

            <!-- Service Status -->
            <Frame BorderColor="{StaticResource Gray200}"
                   CornerRadius="8"
                   Padding="10"
                   IsVisible="{Binding ServiceAvailable, Converter={StaticResource InvertedBoolConverter}}">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="⚠️"
                           FontSize="20"
                           VerticalOptions="Center" />
                    <Label Text="AI service not configured or unavailable. Using demo mode."
                           FontSize="12"
                           TextColor="{StaticResource Tertiary}"
                           VerticalOptions="Center"
                           HorizontalOptions="FillAndExpand" />
                </HorizontalStackLayout>
            </Frame>

            <!-- Input Section -->
            <Frame BorderColor="{StaticResource Gray200}"
                   CornerRadius="10"
                   Padding="15">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Song Information"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Title *"
                               FontSize="14" />
                        <Entry Text="{Binding Title}"
                               Placeholder="Song title..." />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Artist *"
                               FontSize="14" />
                        <Entry Text="{Binding Artist}"
                               Placeholder="Artist name..." />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Key (Optional)"
                               FontSize="14" />
                        <Entry Text="{Binding Key}"
                               Placeholder="e.g., G, Am, D..." />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Lyrics (Optional - helps improve accuracy)"
                               FontSize="14" />
                        <Editor Text="{Binding Lyrics}"
                                Placeholder="Paste lyrics here for better results..."
                                HeightRequest="100" />
                    </VerticalStackLayout>

                    <Button Text="🔮 Get AI Suggestions"
                            Command="{Binding RequestSuggestionCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                            Margin="0,10,0,0" />

                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="{StaticResource Primary}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Suggestion Result -->
            <Frame BorderColor="{StaticResource Primary}"
                   CornerRadius="10"
                   Padding="15"
                   IsVisible="{Binding HasSuggestion}">
                <VerticalStackLayout Spacing="15">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="✨"
                               FontSize="24"
                               VerticalOptions="Center" />
                        <Label Text="Suggested Chords"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="FillAndExpand" />
                        <Label Text="{Binding Source}"
                               FontSize="10"
                               TextColor="{StaticResource Gray500}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding SuggestedKey, StringFormat='Key: {0}'}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           IsVisible="{Binding SuggestedKey}" />

                    <Frame BackgroundColor="{StaticResource Gray100}"
                           Padding="10"
                           CornerRadius="5">
                        <ScrollView HeightRequest="200">
                            <Label Text="{Binding SuggestedChordPro}"
                                   FontFamily="Courier"
                                   FontSize="12" />
                        </ScrollView>
                    </Frame>

                    <!-- Copyright Disclaimer -->
                    <Frame BorderColor="{StaticResource Tertiary}"
                           BackgroundColor="#FFFBF0"
                           Padding="15"
                           CornerRadius="8"
                           IsVisible="{Binding ShowDisclaimer}">
                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="⚠️"
                                       FontSize="20"
                                       VerticalOptions="Center" />
                                <Label Text="Copyright Disclaimer"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Tertiary}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Label Text="{Binding DisclaimerText}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray700}" />

                            <HorizontalStackLayout Spacing="10"
                                                   Margin="0,10,0,0">
                                <CheckBox IsChecked="{Binding DisclaimerAccepted}"
                                          Color="{StaticResource Primary}" />
                                <Label Text="I understand and accept the disclaimer"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Gray900}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleDisclaimerCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Apply Button -->
                    <Button Text="✅ Apply Suggestions to Song"
                            Command="{Binding ApplySuggestionCommand}"
                            BackgroundColor="{StaticResource Success}"
                            IsEnabled="{Binding DisclaimerAccepted}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Help Section -->
            <Frame BorderColor="{StaticResource Gray200}"
                   CornerRadius="10"
                   Padding="15"
                   BackgroundColor="{StaticResource Gray50}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="💡 Tips"
                           FontSize="16"
                           FontAttributes="Bold" />
                    <Label FontSize="12"
                           TextColor="{StaticResource Gray700}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="• Provide accurate title and artist for best results" />
                                <Span Text="&#x0a;" />
                                <Span Text="• Including lyrics helps the AI understand song structure" />
                                <Span Text="&#x0a;" />
                                <Span Text="• Specifying the key improves chord accuracy" />
                                <Span Text="&#x0a;" />
                                <Span Text="• Always verify AI-generated chords before using" />
                                <Span Text="&#x0a;" />
                                <Span Text="• Ensure you have rights to use copyrighted content" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
