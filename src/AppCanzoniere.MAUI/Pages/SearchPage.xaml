<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppCanzoniere.MAUI.ViewModels"
             xmlns:entities="clr-namespace:AppCanzoniere.Domain.Entities;assembly=AppCanzoniere.Domain"
             x:Class="AppCanzoniere.MAUI.Pages.SearchPage"
             x:DataType="vm:SearchViewModel"
             Title="Search">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Search Header -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="10"
                             Spacing="10">
            <SearchBar Placeholder="Search songs by title or artist..."
                       Text="{Binding SearchText}"
                       SearchCommand="{Binding SearchCommand}" />

            <HorizontalStackLayout Spacing="5">
                <Label Text="Filters:"
                       VerticalOptions="Center"
                       FontAttributes="Bold" />
                <Button Text="Tags"
                        Command="{Binding ToggleTagFilterCommand}"
                        FontSize="12"
                        Padding="10,5"
                        BackgroundColor="{StaticResource Primary}" />
                <Button Text="Clear"
                        Command="{Binding ClearSearchCommand}"
                        FontSize="12"
                        Padding="10,5" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Tag Filter Panel -->
        <Frame Grid.Row="1"
               IsVisible="{Binding ShowTagFilter}"
               Margin="10,0"
               Padding="10"
               BackgroundColor="{StaticResource Gray100}"
               CornerRadius="8">
            <VerticalStackLayout Spacing="10">
                <Label Text="Filter by Tags:"
                       FontSize="14"
                       FontAttributes="Bold" />
                
                <FlexLayout BindableLayout.ItemsSource="{Binding AvailableTags}"
                            Wrap="Wrap"
                            JustifyContent="Start"
                            AlignItems="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="entities:Tag">
                            <Frame Padding="10,5"
                                   Margin="5"
                                   CornerRadius="15"
                                   HasShadow="False">
                                <Frame.Triggers>
                                    <DataTrigger TargetType="Frame"
                                                 Binding="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=SelectedTags, Converter={StaticResource ContainsConverter}, ConverterParameter={x:Reference Tag}}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Frame.Triggers>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=ToggleTagSelectionCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Label x:Name="Tag"
                                       Text="{Binding Name}"
                                       FontSize="12" />
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Label Text="Selected tags:"
                       FontSize="12"
                       TextColor="{StaticResource Gray600}"
                       IsVisible="{Binding SelectedTags.Count}" />
                
                <FlexLayout BindableLayout.ItemsSource="{Binding SelectedTags}"
                            Wrap="Wrap"
                            JustifyContent="Start"
                            AlignItems="Start"
                            IsVisible="{Binding SelectedTags.Count}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="entities:Tag">
                            <Frame Padding="8,4"
                                   Margin="3"
                                   BackgroundColor="{StaticResource Primary}"
                                   CornerRadius="12"
                                   HasShadow="False">
                                <Label Text="{Binding Name}"
                                       TextColor="White"
                                       FontSize="10" />
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </Frame>

        <!-- Search Results -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding SearchResults}"
                        SelectionMode="Single"
                        Margin="10">
            <CollectionView.EmptyView>
                <StackLayout Padding="20"
                             VerticalOptions="Center">
                    <Label Text="🔍"
                           FontSize="48"
                           HorizontalOptions="Center" />
                    <Label Text="Start searching"
                           FontSize="18"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource Gray500}"
                           Margin="0,10,0,0" />
                    <Label Text="Type in the search bar or filter by tags"
                           FontSize="14"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource Gray400}" />
                </StackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="entities:Song">
                    <Frame Margin="0,5"
                           Padding="15"
                           BorderColor="{StaticResource Gray200}"
                           CornerRadius="10">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=NavigateToSongCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding Title}"
                                       FontSize="18"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Artist}"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray600}" />
                                <HorizontalStackLayout Spacing="5"
                                                       Margin="0,5,0,0">
                                    <Label Text="{Binding OriginalKey}"
                                           FontSize="12"
                                           TextColor="{StaticResource Primary}"
                                           BackgroundColor="{StaticResource Gray100}"
                                           Padding="5,2" />
                                    <Label Text="{Binding Language}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Image Grid.Column="1"
                                   Source="chevron_right.png"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsSearching}"
                           IsVisible="{Binding IsSearching}"
                           Color="{StaticResource Primary}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />
    </Grid>

</ContentPage>
