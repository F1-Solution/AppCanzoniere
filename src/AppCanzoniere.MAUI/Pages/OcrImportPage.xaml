<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AppCanzoniere.MAUI.ViewModels"
             x:Class="AppCanzoniere.MAUI.Pages.OcrImportPage"
             x:DataType="viewmodels:OcrImportViewModel"
             Title="OCR Import">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Clear"
                     IconImageSource="delete.png"
                     Command="{Binding ClearResultsCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Service Status -->
            <Frame BackgroundColor="{StaticResource Primary}" 
                   Padding="15"
                   CornerRadius="10">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="📷" FontSize="24" VerticalOptions="Center"/>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="OCR Service" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label Text="{Binding ServiceName}" 
                               FontSize="14"
                               TextColor="White"
                               Opacity="0.9"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Frame>

            <!-- Warning if service not available -->
            <Frame BackgroundColor="#FFF3CD" 
                   BorderColor="#FFC107"
                   Padding="15"
                   CornerRadius="10"
                   IsVisible="{Binding IsServiceAvailable, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="⚠️ Service Not Available" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           TextColor="#856404"/>
                    <Label TextColor="#856404">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="The OCR service is not configured. "/>
                                <Span Text="See " />
                                <Span Text="SETUP_INSTRUCTIONS.md" FontAttributes="Bold"/>
                                <Span Text=" for setup steps."/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Frame>

            <!-- Language Selection -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Language" FontSize="16" FontAttributes="Bold"/>
                <Picker ItemsSource="{Binding AvailableLanguages}"
                        SelectedItem="{Binding SelectedLanguage}"
                        Title="Select language"
                        BackgroundColor="{StaticResource Gray100}"/>
            </VerticalStackLayout>

            <!-- File Selection -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Source File" FontSize="16" FontAttributes="Bold"/>
                <Button Text="Select Image or PDF"
                        Command="{Binding SelectFileCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="8"/>
                
                <Label Text="{Binding SelectedFilePath}"
                       FontSize="12"
                       TextColor="{StaticResource Gray600}"
                       LineBreakMode="TailTruncation"
                       IsVisible="{Binding SelectedFilePath, Converter={StaticResource StringToBoolConverter}}"/>
            </VerticalStackLayout>

            <!-- Process Button -->
            <Button Text="Process with OCR"
                    Command="{Binding ProcessFileCommand}"
                    IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"/>

            <!-- Processing Indicator -->
            <ActivityIndicator IsRunning="{Binding IsProcessing}"
                              IsVisible="{Binding IsProcessing}"
                              Color="{StaticResource Primary}"
                              HeightRequest="50"/>

            <!-- Error Message -->
            <Frame BackgroundColor="#F8D7DA" 
                   BorderColor="#DC3545"
                   Padding="15"
                   CornerRadius="10"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}">
                <VerticalStackLayout Spacing="5">
                    <Label Text="❌ Error" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           TextColor="#721C24"/>
                    <Label Text="{Binding ErrorMessage}" 
                           TextColor="#721C24"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Results Section -->
            <VerticalStackLayout Spacing="15" IsVisible="{Binding HasResult}">
                
                <!-- Confidence -->
                <HorizontalStackLayout Spacing="10">
                    <Label Text="Confidence:" 
                           FontSize="14" 
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                    <Label VerticalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Confidence, StringFormat='{0:P0}'}" 
                                      FontSize="14"
                                      FontAttributes="Bold"
                                      TextColor="{StaticResource Success}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </HorizontalStackLayout>

                <!-- Extracted Text -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Extracted Text (ChordPro Format)" 
                           FontSize="16" 
                           FontAttributes="Bold"/>
                    
                    <Frame BorderColor="{StaticResource Gray300}"
                           BackgroundColor="{StaticResource Gray50}"
                           Padding="10"
                           CornerRadius="8">
                        <Editor Text="{Binding ExtractedText}"
                                FontFamily="Courier"
                                FontSize="12"
                                MinimumHeightRequest="300"
                                MaximumHeightRequest="500"
                                BackgroundColor="Transparent"/>
                    </Frame>
                </VerticalStackLayout>

                <!-- Action Buttons -->
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Button Text="Create Song"
                            Command="{Binding CreateSongCommand}"
                            BackgroundColor="{StaticResource Success}"
                            TextColor="White"
                            CornerRadius="8"
                            WidthRequest="150"/>
                    
                    <Button Text="Clear"
                            Command="{Binding ClearResultsCommand}"
                            BackgroundColor="{StaticResource Gray500}"
                            TextColor="White"
                            CornerRadius="8"
                            WidthRequest="150"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Instructions -->
            <Frame BackgroundColor="{StaticResource Gray50}" 
                   BorderColor="{StaticResource Gray300}"
                   Padding="15"
                   CornerRadius="10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="💡 Tips" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>
                    <Label TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="• Use high-quality images with clear text"/>
                                <Span Text="&#x0a;"/>
                                <Span Text="• Ensure good lighting and contrast"/>
                                <Span Text="&#x0a;"/>
                                <Span Text="• The OCR works best with printed text"/>
                                <Span Text="&#x0a;"/>
                                <Span Text="• Review and edit extracted text before saving"/>
                                <Span Text="&#x0a;"/>
                                <Span Text="• Use ChordPro format: [C]chord [G]markup"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
