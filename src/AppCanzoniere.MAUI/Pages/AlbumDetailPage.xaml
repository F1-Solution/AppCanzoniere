<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppCanzoniere.MAUI.ViewModels"
             xmlns:entities="clr-namespace:AppCanzoniere.Domain.Entities;assembly=AppCanzoniere.Domain"
             x:Class="AppCanzoniere.MAUI.Pages.AlbumDetailPage"
             x:DataType="vm:AlbumDetailViewModel"
             Title="{Binding Album.Name}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Edit"
                     IconImageSource="edit.png"
                     Command="{Binding ToggleEditModeCommand}"
                     IsVisible="{Binding IsEditMode, Converter={StaticResource InvertedBoolConverter}}" />
        <ToolbarItem Text="Delete"
                     IconImageSource="delete.png"
                     Command="{Binding DeleteCommand}" />
        <ToolbarItem Text="Add Songs"
                     IconImageSource="add.png"
                     Command="{Binding ToggleAddingSongsCommand}"
                     IsVisible="{Binding IsAddingSongs, Converter={StaticResource InvertedBoolConverter}}" />
    </ContentPage.ToolbarItems>

    <Grid>
        <!-- Main Content -->
        <ScrollView IsVisible="{Binding IsAddingSongs, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Padding="15"
                                 Spacing="20">
                <!-- Album Info Header -->
                <Frame BackgroundColor="{StaticResource Primary}"
                       CornerRadius="10"
                       Padding="20">
                    <VerticalStackLayout Spacing="10">
                        <Entry Text="{Binding Album.Name}"
                               Placeholder="Album Name"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="White"
                               IsEnabled="{Binding IsEditMode}" />

                        <Editor Text="{Binding Album.Description}"
                                Placeholder="Description"
                                FontSize="14"
                                TextColor="White"
                                HeightRequest="60"
                                IsEnabled="{Binding IsEditMode}" />

                        <Picker ItemsSource="{Binding AlbumTypes}"
                                SelectedItem="{Binding Album.Type}"
                                TextColor="White"
                                IsEnabled="{Binding IsEditMode}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Save/Cancel Buttons (Edit Mode) -->
                <HorizontalStackLayout Spacing="10"
                                       IsVisible="{Binding IsEditMode}"
                                       HorizontalOptions="Fill">
                    <Button Text="Save"
                            Command="{Binding SaveCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            HorizontalOptions="FillAndExpand" />
                    <Button Text="Cancel"
                            Command="{Binding ToggleEditModeCommand}"
                            BackgroundColor="{StaticResource Gray300}"
                            TextColor="{StaticResource Gray900}"
                            HorizontalOptions="FillAndExpand" />
                </HorizontalStackLayout>

                <!-- Songs in Album -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Songs"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <CollectionView ItemsSource="{Binding AlbumSongs}">
                        <CollectionView.EmptyView>
                            <StackLayout Padding="20"
                                         HorizontalOptions="Center">
                                <Label Text="No songs in this album"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray500}"
                                       HorizontalOptions="Center" />
                                <Label Text="Tap 'Add Songs' to add songs"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray400}"
                                       HorizontalOptions="Center" />
                            </StackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="entities:AlbumSong">
                                <Frame Margin="0,5"
                                       Padding="10"
                                       BorderColor="{StaticResource Gray200}"
                                       CornerRadius="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                          ColumnSpacing="10">
                                        <!-- Order Index -->
                                        <Label Grid.Column="0"
                                               Text="{Binding OrderIndex}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"
                                               VerticalOptions="Center"
                                               WidthRequest="30" />

                                        <!-- Song Info -->
                                        <VerticalStackLayout Grid.Column="1"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Song.Title}"
                                                   FontSize="16"
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding Song.Artist}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource Gray600}" />
                                        </VerticalStackLayout>

                                        <!-- Move Up/Down Buttons -->
                                        <VerticalStackLayout Grid.Column="2"
                                                             Spacing="5">
                                            <Button Text="▲"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AlbumDetailViewModel}}, Path=MoveSongUpCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontSize="12"
                                                    WidthRequest="40"
                                                    HeightRequest="30"
                                                    Padding="0" />
                                            <Button Text="▼"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AlbumDetailViewModel}}, Path=MoveSongDownCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontSize="12"
                                                    WidthRequest="40"
                                                    HeightRequest="30"
                                                    Padding="0" />
                                        </VerticalStackLayout>

                                        <!-- Remove Button -->
                                        <Button Grid.Column="3"
                                                Text="✕"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AlbumDetailViewModel}}, Path=RemoveSongFromAlbumCommand}"
                                                CommandParameter="{Binding .}"
                                                FontSize="16"
                                                BackgroundColor="{StaticResource Tertiary}"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                CornerRadius="20"
                                                Padding="0"
                                                VerticalOptions="Center" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Add Songs Panel -->
        <Grid IsVisible="{Binding IsAddingSongs}"
              BackgroundColor="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Frame Grid.Row="0"
                   BackgroundColor="{StaticResource Primary}"
                   CornerRadius="0"
                   Padding="15">
                <HorizontalStackLayout Spacing="10">
                    <Button Text="✕"
                            Command="{Binding CancelAddingSongsCommand}"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="20"
                            WidthRequest="40"
                            Padding="0" />
                    <Label Text="Add Songs to Album"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Frame>

            <!-- Search -->
            <SearchBar Grid.Row="1"
                       Placeholder="Search songs..."
                       Text="{Binding SearchAvailableText}"
                       SearchCommand="{Binding LoadAvailableSongsCommand}"
                       Margin="10" />

            <!-- Available Songs List -->
            <CollectionView Grid.Row="2"
                            ItemsSource="{Binding AvailableSongs}"
                            Margin="10">
                <CollectionView.EmptyView>
                    <Label Text="No songs available"
                           FontSize="14"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:Song">
                        <Frame Margin="0,5"
                               Padding="15"
                               BorderColor="{StaticResource Gray200}"
                               CornerRadius="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding Title}"
                                           FontSize="16"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding Artist}"
                                           FontSize="14"
                                           TextColor="{StaticResource Gray600}" />
                                </VerticalStackLayout>

                                <Button Grid.Column="1"
                                        Text="+"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AlbumDetailViewModel}}, Path=AddSongToAlbumCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="{StaticResource Primary}"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        CornerRadius="20"
                                        FontSize="20"
                                        Padding="0"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>

</ContentPage>
