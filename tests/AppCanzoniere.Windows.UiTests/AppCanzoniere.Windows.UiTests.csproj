<Project Sdk="Microsoft.NET.Sdk">

  <!-- Launches the built MAUI Windows app; kept out of AppCanzoniere.Core.slnx because it needs a desktop session. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="FlaUI.UIA3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AppCanzoniere.Application\AppCanzoniere.Application.csproj" />
    <ProjectReference Include="..\..\src\AppCanzoniere.Infrastructure\AppCanzoniere.Infrastructure.csproj" />
  </ItemGroup>

</Project>
